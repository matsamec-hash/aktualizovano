---
// Blok „Fotografie" pod výpisem článků — homepage, rubriky, vyhledávání.
//
// Proč i na výpisech: fotka na kartě je stejné užití díla jako fotka v článku.
// Kredit byl 11. 9. 2026 jen na detailu, takže homepage zobrazovala 18 cover
// fotek a nula jmen autorů. U mřížky miniatur by popisek u každé karty rozbil
// layout, proto souhrnný blok na konci stránky — stejné řešení jako uvnitř
// článku (`PhotoCredits.astro`), jen přes víc článků a bez obrázků v textu.
//
// ‼️ Licence se vypisuje jako ODKAZ: CC BY / CC BY-SA vyžadují jméno autora,
// název licence i odkaz na její text.
import { creditFor, creditFromDb, type PhotoCredit } from "../lib/photo-credits";
import type { Article } from "../lib/types";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

// Na výpisu se zobrazuje jen úvodní fotka, ne obrázky z těla článku — do
// seznamu tedy patří právě ony, ať kredity odpovídají tomu, co je vidět.
const credits: PhotoCredit[] = [];
const videno = new Set<string>();
for (const article of articles ?? []) {
  if (!article?.featured_image_url) continue;
  const c =
    creditFromDb(article.featured_image_credit) ?? creditFor(article.featured_image_url);
  if (!c) continue;
  const klic = `${c.author}|${c.license}|${c.sourceUrl}`;
  if (videno.has(klic)) continue;
  videno.add(klic);
  credits.push(c);
}
---

{credits.length > 0 && (
  <section
    class="mt-16 pt-6 border-t border-[var(--color-border)]"
    aria-labelledby="fotografie-vypis-heading"
  >
    <h2
      id="fotografie-vypis-heading"
      class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)] mb-3"
    >
      Fotografie
    </h2>
    <ul class="text-xs text-[var(--color-text-muted)] leading-relaxed space-y-1">
      {credits.map((c) => (
        <li>
          {c.authorUrl ? (
            <a href={c.authorUrl} rel="nofollow noopener" target="_blank" class="underline">
              {c.author}
            </a>
          ) : (
            c.author
          )}
          {c.license && (
            <>
              {" · "}
              {c.licenseUrl ? (
                <a
                  href={c.licenseUrl}
                  rel="license nofollow noopener"
                  target="_blank"
                  class="underline"
                >
                  {c.license}
                </a>
              ) : (
                c.license
              )}
            </>
          )}
          {c.sourceUrl && (
            <>
              {" · "}
              <a href={c.sourceUrl} rel="nofollow noopener" target="_blank" class="underline">
                originál
              </a>
            </>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
