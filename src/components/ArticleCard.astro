---
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";

interface Props {
  article: Article;
  priority?: boolean;
}

const { article, priority = false } = Astro.props;
const readTime = Math.max(1, Math.ceil((article.content?.length || 0) / 1500));
const fp = article.focal_point || { x: 50, y: 50 };
const categoryLabel = siteConfig.categories.find((c) => c.slug === article.category)?.label ?? article.category;
const altText = article.featured_image_alt || article.title;
---

<a href={`/${article.slug}/`} class="block group">
  <div class="rounded-lg overflow-hidden mb-3 bg-[var(--color-bg-soft)]" style="aspect-ratio: 16/10;">
    {article.featured_image_url ? (
      <img
        src={article.featured_image_url}
        alt={altText}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        width="800"
        height="500"
        sizes="(min-width: 768px) 33vw, 100vw"
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
        style={`object-position: ${fp.x}% ${fp.y}%;`}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-[var(--color-text-muted)]">
        <span class="text-3xl opacity-40">📝</span>
      </div>
    )}
  </div>
  {categoryLabel && (
    <span class="text-[11px] uppercase tracking-widest font-semibold" style={`color: var(--color-accent)`}>
      {categoryLabel}
    </span>
  )}
  <h3 class="mt-1.5 font-display text-xl font-bold leading-tight text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
    {article.title}
  </h3>
  {article.perex && (
    <p class="text-sm mt-2 text-[var(--color-text-muted)] line-clamp-2">{article.perex}</p>
  )}
  <p class="text-xs mt-2 text-[var(--color-text-muted)]">{readTime} min čtení</p>
</a>
