---
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";
import ResponsiveImage from "./ResponsiveImage.astro";
import { IMG_WIDTHS, IMG_SIZES } from "../lib/imageSizes";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const slides = articles.slice(0, 4);

function meta(a: Article) {
  return {
    cat: siteConfig.categories.find((c) => c.slug === a.category)?.label ?? a.category,
    alt: a.featured_image_alt || a.title,
    readTime: Math.max(1, Math.ceil((a.content?.length || 0) / 1500)),
    fp: a.focal_point || { x: 50, y: 50 },
  };
}
---

<section class="relative w-full overflow-hidden bg-[var(--color-primary)]" data-hero-carousel>
  <div class="relative min-h-[52vh] md:min-h-[60vh]">
    {slides.map((article, i) => {
      const m = meta(article);
      return (
        <article
          data-slide={i}
          class:list={[
            "absolute inset-0 transition-opacity duration-700 ease-out",
            i === 0 ? "opacity-100" : "opacity-0 pointer-events-none",
          ]}
        >
          {article.featured_image_url ? (
            <ResponsiveImage
              src={article.featured_image_url}
              alt={m.alt}
              widths={IMG_WIDTHS.hero}
              sizes={IMG_SIZES.hero}
              width={2000}
              height={1200}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${m.fp.x}% ${m.fp.y}%;`}
            />
          ) : (
            <div class="absolute inset-0 bg-[var(--color-bg-soft)]"></div>
          )}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/35 via-transparent to-black/45"></div>

          <a href={`/${article.slug}/`} class="group relative block h-full">
            <div class="mx-auto flex h-full max-w-7xl items-center px-4 py-12 sm:px-6 lg:px-8">
              <div class="max-w-md rounded-xl bg-black/30 p-4 ring-1 ring-white/15 backdrop-blur-md sm:p-5">
                {m.cat && (
                  <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/90">{m.cat}</span>
                )}
                <h1 class="font-display mt-2 text-lg font-black leading-[1.1] text-white transition-colors group-hover:text-white/90 sm:text-xl md:text-2xl xl:text-[1.6rem]">
                  {article.title}
                </h1>
                {article.perex && (
                  <p class="mt-2.5 text-sm leading-relaxed text-white/85 line-clamp-2">{article.perex}</p>
                )}
                <p class="mt-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-white/70">{m.readTime} min čtení</p>
              </div>
            </div>
          </a>
        </article>
      );
    })}

    {slides.length > 1 && (
      <div class="absolute right-4 top-1/2 z-10 flex -translate-y-1/2 flex-col gap-2.5 sm:right-6 lg:right-8">
        {slides.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Článek ${i + 1}`}
            class:list={[
              "h-2.5 w-2.5 rounded-full ring-1 ring-white/60 transition-colors",
              i === 0 ? "bg-white" : "bg-white/0 hover:bg-white/50",
            ]}
          ></button>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll("[data-hero-carousel]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll("[data-slide]"));
    const dots = Array.from(root.querySelectorAll("[data-dot]"));
    const n = slides.length;
    if (n < 2) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function go(i: number) {
      idx = (i + n) % n;
      slides.forEach((s, j) => {
        const active = j === idx;
        s.classList.toggle("opacity-100", active);
        s.classList.toggle("opacity-0", !active);
        s.classList.toggle("pointer-events-none", !active);
      });
      dots.forEach((d, j) => {
        const active = j === idx;
        d.classList.toggle("bg-white", active);
        d.classList.toggle("bg-white/0", !active);
        d.classList.toggle("hover:bg-white/50", !active);
      });
    }

    function restart() {
      if (reduce) return;
      if (timer) clearInterval(timer);
      timer = setInterval(() => go(idx + 1), 6000);
    }

    dots.forEach((d, i) =>
      d.addEventListener("click", (e) => {
        e.preventDefault();
        go(i);
        restart();
      })
    );

    restart();
  });
</script>
