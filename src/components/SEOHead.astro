---
import { siteConfig } from "../../site.config";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  slug?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  publishedTime?: string | null;
  modifiedTime?: string | null;
}

const {
  title,
  description,
  image,
  type = "website",
  slug = "",
  canonical: canonicalProp,
  robots,
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;
// Web běží na trailingSlash: 'always' → kanonická URL MUSÍ mít koncové lomítko,
// jinak ukazuje na URL, která 301 redirectuje (Ahrefs: "canonical points to redirect").
// Bez slug i bez explicitní canonical (404) kanonickou raději nevypisujeme, než
// abychom celou stránku kanonizovali na homepage.
const withTrailingSlash = (url: string): string =>
  /\/$|\.[a-z0-9]+$/i.test(url) ? url : `${url}/`;
const canonicalBase = canonicalProp ?? (slug ? `https://${siteConfig.domain}/${slug}` : null);
const canonicalUrl = canonicalBase ? withTrailingSlash(canonicalBase) : null;
const ogUrl = canonicalUrl ?? `https://${siteConfig.domain}/`;
const ogImage = image || `https://${siteConfig.domain}/og-default.jpg`;

// Brand suffix do <title> (ne do og/twitter — sociální preview čistší bez
// brandu). Stránky, které brand už mají (homepage, kategorie), nepřebrandujeme.
const pageTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;

// Meta description: dekódovat HTML entity (&nbsp; apod.), strip tagů, sjednotit
// whitespace a oříznout na ≤160 znaků na hranici slova. seo_description/perex
// z CMS bývají useknuté uprostřed věty a obsahují syrové entity.
function cleanDescription(raw: string | undefined): string {
  const decoded = (raw ?? "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;|&apos;|&rsquo;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&hellip;/g, "…")
    .replace(/\s+/g, " ")
    .trim();
  if (decoded.length <= 160) return decoded;
  const cut = decoded.slice(0, 157);
  const lastSpace = cut.lastIndexOf(" ");
  return `${(lastSpace > 100 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:–—-]+$/, "")}…`;
}
const metaDescription = cleanDescription(description);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteConfig.name,
  "url": `https://${siteConfig.domain}/`,
  "sameAs": siteConfig.networkSites.map((s) => `https://${s.domain}/`),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.name,
  "alternateName": siteConfig.tagline,
  "url": `https://${siteConfig.domain}/`,
  "inLanguage": "cs-CZ",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `https://${siteConfig.domain}/hledat/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const baseJsonLd = [orgJsonLd, websiteJsonLd];
const allJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [...baseJsonLd, ...jsonLd]
    : [...baseJsonLd, jsonLd]
  : baseJsonLd;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content={siteConfig.colors.primary} />
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
{robots && <meta name="robots" content={robots} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

<link rel="preconnect" href="https://cdn.samecdigital.com" crossorigin />
<link rel="dns-prefetch" href="https://cdn.samecdigital.com" />

<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={ogUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="cs_CZ" />
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={`https://${siteConfig.domain}/rss.xml`} />

{allJsonLd.map((ld) => (
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
))}

{/* GA4 placeholder — Phase 4 launch dodá measurement ID */}