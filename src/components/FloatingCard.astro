---
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";
import ResponsiveImage from "./ResponsiveImage.astro";
import { IMG_WIDTHS, IMG_SIZES } from "../lib/imageSizes";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const fp = article.focal_point || { x: 50, y: 50 };
const categoryLabel = siteConfig.categories.find((c) => c.slug === article.category)?.label ?? article.category;
const altText = article.featured_image_alt || article.title;
---

<a
  href={`/${article.slug}/`}
  class="group flex items-stretch gap-4 bg-[var(--color-bg)] p-3 shadow-[0_8px_30px_rgba(0,0,0,0.12)] ring-1 ring-black/5 transition-shadow hover:shadow-[0_12px_40px_rgba(0,0,0,0.18)]"
>
  <div class="aspect-square w-20 shrink-0 overflow-hidden bg-[var(--color-bg-soft)] sm:w-16 md:w-20">
    {article.featured_image_url ? (
      <ResponsiveImage
        src={article.featured_image_url}
        alt={altText}
        widths={IMG_WIDTHS.thumb}
        sizes={IMG_SIZES.thumb}
        width={96}
        height={96}
        class="h-full w-full object-cover"
        style={`object-position: ${fp.x}% ${fp.y}%;`}
      />
    ) : (
      <div class="h-full w-full"></div>
    )}
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-center">
    <h3 class="font-display text-sm font-bold leading-snug text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)] line-clamp-2">
      {article.title}
    </h3>
    {categoryLabel && (
      <span class="mt-1.5 text-[10px] font-bold uppercase tracking-widest text-[var(--color-text-muted)]">
        {categoryLabel}
      </span>
    )}
  </div>
</a>
