---
import { siteConfig } from "../../site.config";
const currentPath = Astro.url.pathname;

const rawDate = new Date().toLocaleDateString("cs-CZ", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const today = rawDate.charAt(0).toUpperCase() + rawDate.slice(1);
---

<header class="sticky top-0 z-50 bg-[var(--color-bg)]">
  <!-- utility strip -->
  <div class="border-b border-[var(--color-border)] bg-[var(--color-bg-soft)]">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-1.5 sm:px-6 lg:px-8">
      <span class="text-[11px] font-medium uppercase tracking-widest text-[var(--color-text-muted)]">{today}</span>
      <span class="hidden text-[11px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)] sm:block">{siteConfig.tagline}</span>
    </div>
  </div>

  <!-- main bar -->
  <div class="border-b border-[var(--color-text)] bg-[var(--color-bg)]">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
      <a href="/" class="group flex shrink-0 items-center gap-2 no-underline">
        <span class="inline-block h-6 w-2 bg-[var(--color-accent)] transition-transform group-hover:scale-y-110"></span>
        <span class="font-display text-xl font-black uppercase tracking-tight text-[var(--color-primary)] sm:text-2xl">
          {siteConfig.name}
        </span>
      </a>

      <nav class="hidden items-center gap-7 lg:flex">
        {siteConfig.categories.map((cat) => {
          const active = currentPath.startsWith(`/kategorie/${cat.slug}`);
          return (
            <a
              href={`/kategorie/${cat.slug}/`}
              class:list={[
                "relative py-1 text-[13px] font-bold uppercase tracking-wide transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-[var(--color-accent)] after:transition-all",
                active
                  ? "text-[var(--color-text)] after:w-full"
                  : "text-[var(--color-text-muted)] after:w-0 hover:text-[var(--color-text)] hover:after:w-full",
              ]}
            >
              {cat.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-1.5">
        <a
          href="/hledat"
          aria-label="Hledat"
          class="flex h-9 w-9 items-center justify-center text-[var(--color-text)] transition-colors hover:text-[var(--color-accent)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
        </a>
        <button id="menu-toggle" class="flex h-9 w-9 items-center justify-center text-[var(--color-text)] lg:hidden" aria-label="Otevřít menu" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-b border-[var(--color-border)] bg-[var(--color-bg-soft)] lg:hidden">
    {siteConfig.categories.map((cat) => (
      <a href={`/kategorie/${cat.slug}/`} class="block border-t border-[var(--color-border)] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[var(--color-text)] first:border-t-0 hover:bg-[var(--color-bg)] hover:text-[var(--color-accent)]">
        {cat.label}
      </a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  toggle?.addEventListener("click", () => {
    const menu = document.getElementById("mobile-menu");
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", open ? "false" : "true");
  });
</script>
