---
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const readTime = Math.max(1, Math.ceil((article.content?.length || 0) / 1500));
const fp = article.focal_point || { x: 50, y: 50 };
const categoryLabel = siteConfig.categories.find((c) => c.slug === article.category)?.label ?? article.category;
const altText = article.featured_image_alt || article.title;
---

<a href={`/${article.slug}/`} class="block group rounded-xl overflow-hidden bg-[var(--color-bg-soft)] border border-[var(--color-border)]">
  <div class="grid md:grid-cols-2 gap-0">
    <div class="aspect-[4/3] md:aspect-auto overflow-hidden">
      {article.featured_image_url ? (
        <img
          src={article.featured_image_url}
          alt={altText}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="900"
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
          style={`object-position: ${fp.x}% ${fp.y}%;`}
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-[var(--color-text-muted)]">
          <span class="text-5xl opacity-30">📰</span>
        </div>
      )}
    </div>
    <div class="p-6 md:p-10 flex flex-col justify-center">
      {categoryLabel && (
        <span class="text-xs uppercase tracking-widest font-semibold mb-3" style={`color: var(--color-accent)`}>
          {categoryLabel}
        </span>
      )}
      <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
        {article.title}
      </h2>
      {article.perex && (
        <p class="mt-4 text-base text-[var(--color-text-muted)] line-clamp-3">{article.perex}</p>
      )}
      <p class="text-xs mt-4 text-[var(--color-text-muted)]">{readTime} min čtení</p>
    </div>
  </div>
</a>
