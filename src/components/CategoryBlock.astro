---
import RailStory from "./RailStory.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import { IMG_WIDTHS, IMG_SIZES } from "../lib/imageSizes";
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";

interface Props {
  category: { slug: string; label: string; description: string };
  articles: Article[];
  index?: number;
}

const { category, articles, index = 0 } = Astro.props;
const isRightCol = index % 2 === 1;
const lead = articles[0];
const rest = articles.slice(1, 3);
const fp = lead?.focal_point || { x: 50, y: 50 };
const leadAlt = lead?.featured_image_alt || lead?.title || "";
---

<div class:list={[isRightCol && "lg:border-l lg:border-[var(--color-border)] lg:pl-10", !isRightCol && "lg:pr-10"]}>
  <div class="mb-5 flex items-center justify-between border-b-2 border-[var(--color-text)] pb-2">
    <div class="flex items-baseline gap-2.5">
      <span class="h-3.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight text-[var(--color-text)]">{category.label}</h2>
    </div>
    <a href={`/kategorie/${category.slug}/`} class="shrink-0 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] hover:underline">
      Vše →
    </a>
  </div>

  {lead && (
    <a href={`/${lead.slug}/`} class="group block">
      <div class="overflow-hidden bg-[var(--color-bg-soft)]" style="aspect-ratio: 16/10;">
        {lead.featured_image_url && (
          <ResponsiveImage
            src={lead.featured_image_url}
            alt={leadAlt}
            widths={IMG_WIDTHS.card}
            sizes={IMG_SIZES.cardHalf}
            width={800}
            height={500}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            style={`object-position: ${fp.x}% ${fp.y}%;`}
          />
        )}
      </div>
      <h3 class="font-display mt-3 text-xl font-bold leading-tight text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)]">
        {lead.title}
      </h3>
      {lead.perex && (
        <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2">{lead.perex}</p>
      )}
    </a>
  )}

  {rest.length > 0 && (
    <div class="mt-2 flex flex-col divide-y divide-[var(--color-border)]">
      {rest.map((article) => <RailStory article={article} />)}
    </div>
  )}
</div>
