---
import { siteConfig } from "../../site.config";
---

<footer class="bg-[var(--color-bg-soft)] border-t border-[var(--color-border)] mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <p class="font-display text-xl font-bold mb-2" style={`color: var(--color-primary)`}>{siteConfig.name}</p>
        <p class="text-sm text-[var(--color-text-muted)]">{siteConfig.tagline}</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)] mb-3">Rubriky</p>
        <ul class="space-y-1">
          {siteConfig.categories.map((cat) => (
            <li>
              <a href={`/kategorie/${cat.slug}/`} class="text-sm text-[var(--color-text)] hover:text-[var(--color-accent)]">{cat.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)] mb-3">Síť projektů</p>
        <ul class="space-y-1">
          {siteConfig.networkSites.map((site) => (
            <li>
              <a href={`https://${site.domain}`} class="text-sm text-[var(--color-text)] hover:text-[var(--color-accent)]" target="_blank" rel="noopener">
                {site.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-[var(--color-border)]">
      <p class="text-sm text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} {siteConfig.name}. Všechna práva vyhrazena.
      </p>
      <div class="flex gap-4">
        <a href="/o-nas/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">O nás</a>
        <a href="/zasady-ochrany-osobnich-udaju/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Zásady ochrany</a>
        <a href="/podminky-pouzivani/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Podmínky</a>
        <a href="/cookies/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Cookies</a>
        <a href="#" data-cc-reopen class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Nastavení cookies</a>
      </div>
    </div>
  </div>
</footer>
