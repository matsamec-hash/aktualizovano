---
import Base from "./Base.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { IMG_WIDTHS, IMG_SIZES } from "../lib/imageSizes";
import { getImage } from "astro:assets";
import { siteConfig } from "../../site.config";
import type { Article } from "../lib/types";
import sanitizeHtml from "sanitize-html";
import { preprocessContent } from "../lib/content";
import { autoLinkContent } from "../lib/auto-linker";

interface Props {
  article: Article;
  relatedArticles: Article[];
  others?: Article[];
}

const { article, relatedArticles, others = [] } = Astro.props;
const readTime = Math.max(1, Math.ceil((article.content?.length || 0) / 1500));

const linkedRaw = autoLinkContent(article.content || "", article, others);
const preprocessed = preprocessContent(linkedRaw)
  // WP obsah občas nese vlastní <h1> (mezititulky) → na stránce by byly 2+ H1.
  // H1 je titulek článku v šabloně, obsahové nadpisy patří o úroveň níž.
  .replace(/<(\/?)h1(\b[^>]*)>/gi, "<$1h2$2>");

const safeContent = sanitizeHtml(preprocessed, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "figure", "figcaption", "iframe", "video", "source"]),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    img: ["src", "alt", "title", "width", "height", "loading", "decoding", "fetchpriority", "sizes", "srcset"],
    a: ["href", "title", "rel", "target", "class"],
    iframe: ["src", "width", "height", "frameborder", "allowfullscreen", "allow", "loading"],
    video: ["src", "controls", "width", "height"],
    source: ["src", "type"],
    "*": ["class", "id", "style"],
  },
  allowedIframeHostnames: ["www.youtube.com", "player.vimeo.com"],
});

const publishDate = article.published_at
  ? new Date(article.published_at).toLocaleDateString("cs", { day: "numeric", month: "long", year: "numeric" })
  : "";
const publishedIso = article.published_at ? new Date(article.published_at).toISOString() : undefined;
// Pozn.: sloupec se jmenuje last_updated_at (ne updated_at — ten v DB neexistoval,
// takže dateModified vždy padal na published). Až CMS edituje článek, promítne se.
const modifiedIso = article.last_updated_at
  ? new Date(article.last_updated_at).toISOString()
  : publishedIso;

const altText = article.featured_image_alt || article.title;
// LCP preload featured obrázku – optimalizovaná webp varianta matchující <img> níž.
let preloadHref = article.featured_image_url || undefined;
let preloadSrcset: string | undefined;
if (article.featured_image_url) {
  try {
    const opt = await getImage({ src: article.featured_image_url, inferSize: true, widths: IMG_WIDTHS.featured, format: "webp" });
    preloadHref = opt.src;
    preloadSrcset = opt.srcSet.attribute;
  } catch {
    // Mrtvá/nepodporovaná URL → fallback na originál.
  }
}
const url = `https://${siteConfig.domain}/${article.slug}/`;
const categoryConfig = siteConfig.categories.find((c) => c.slug === article.category);

// NewsArticle pro běžné zpravodajství; evergreen obsah zůstává Article.
// Explicitní schema_type z DM (jiný než default "Article") má přednost.
const articleExtra = article as Article & { evergreen?: boolean; schema_type?: string };
const schemaType =
  articleExtra.schema_type && articleExtra.schema_type !== "Article"
    ? articleExtra.schema_type
    : articleExtra.evergreen
      ? "Article"
      : "NewsArticle";
// Google doporučuje headline ≤110 znaků (NewsArticle).
const headline = article.title.length > 110 ? `${article.title.slice(0, 107).trimEnd()}…` : article.title;

const sameCategory = (others ?? [])
  .filter((a) => a.category === article.category && a.published_at)
  .sort((a, b) => new Date(b.published_at!).getTime() - new Date(a.published_at!).getTime());
const allInCat = [...sameCategory, article].sort(
  (a, b) => new Date(b.published_at ?? 0).getTime() - new Date(a.published_at ?? 0).getTime(),
);
const idx = allInCat.findIndex((a) => a.id === article.id);
const newer = idx > 0 ? allInCat[idx - 1] : null;
const older = idx < allInCat.length - 1 ? allInCat[idx + 1] : null;

const featuredImageObject = article.featured_image_url
  ? {
      "@type": "ImageObject",
      "url": article.featured_image_url,
      "width": 1200,
      "height": 675,
    }
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "headline": headline,
  "description": article.seo_description || article.perex,
  ...(featuredImageObject ? { "image": featuredImageObject } : {}),
  "datePublished": publishedIso,
  "dateModified": modifiedIso,
  "author": {
    "@type": "Person",
    "@id": `https://${siteConfig.domain}/o-nas/#redakce`,
    "name": `Redakce ${siteConfig.name}`,
    "url": `https://${siteConfig.domain}/o-nas/`,
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "url": `https://${siteConfig.domain}/`,
    "logo": {
      "@type": "ImageObject",
      "url": `https://${siteConfig.domain}/og-default.jpg`,
      "width": 1200,
      "height": 630,
    },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": url },
  "articleSection": categoryConfig?.label ?? article.category,
  ...(article.tags && article.tags.length > 0 ? { "keywords": article.tags.slice(0, 10).join(", ") } : {}),
  "wordCount": (article.content || "").replace(/<[^>]*>/g, " ").trim().split(/\s+/).filter(Boolean).length,
  "inLanguage": "cs-CZ",
};

// FAQ (AEO) — viditelná sekce + FAQPage schema musí MATCHOVAT (Google guidelines:
// FAQ obsah musí být na stránce viditelný, jinak hrozí manual action). Prázdné dokud
// CMS „AEO fill" nenaplní faq_items.
const faqItems = (article.faq_items || []).filter(
  (f) => f && typeof f.question === "string" && f.question.trim() && typeof f.answer === "string" && f.answer.trim(),
);
const tldr = (article.tldr || "").trim();
const faqLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map((f) => ({
          "@type": "Question",
          "name": f.question.trim(),
          "acceptedAnswer": { "@type": "Answer", "text": f.answer.trim() },
        })),
      }
    : null;

const breadcrumbItems = [
  { name: "Domů", href: `/` },
  ...(categoryConfig ? [{ name: categoryConfig.label, href: `/kategorie/${categoryConfig.slug}/` }] : []),
  { name: article.title },
];

const breadcrumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Domů", "item": `https://${siteConfig.domain}/` },
    ...(categoryConfig
      ? [{
          "@type": "ListItem",
          "position": 2,
          "name": categoryConfig.label,
          "item": `https://${siteConfig.domain}/kategorie/${categoryConfig.slug}/`,
        }]
      : []),
    {
      "@type": "ListItem",
      "position": categoryConfig ? 3 : 2,
      "name": article.title,
      "item": url,
    },
  ],
};
---

<Base
  title={article.seo_title || article.title}
  description={article.seo_description || article.perex}
  image={article.featured_image_url || undefined}
  type="article"
  slug={article.slug}
  canonical={url}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  jsonLd={[articleJsonLd, breadcrumbsLd, ...(faqLd ? [faqLd] : [])]}
  preloadImage={preloadHref}
  preloadImageSrcset={preloadSrcset}
  preloadImageSizes={IMG_SIZES.featured}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10" data-pagefind-body data-pagefind-filter={`Kategorie:${categoryConfig?.label || ''}`}>
    <Breadcrumbs items={breadcrumbItems} class="mb-6" />
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs">
        {categoryConfig && (
          <a href={`/kategorie/${categoryConfig.slug}/`} class="px-3 py-1 rounded uppercase tracking-widest font-semibold text-white" style={`background: var(--color-accent)`}>
            {categoryConfig.label}
          </a>
        )}
        <span class="text-[var(--color-text-muted)]">{readTime} min čtení</span>
        {publishDate && <span class="text-[var(--color-text-muted)]">{publishDate}</span>}
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight text-[var(--color-text)]">
        {article.title}
      </h1>
      {article.perex && (
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed">{article.perex}</p>
      )}
    </header>

    {article.featured_image_url && (
      <figure class="mb-8 -mx-4 sm:-mx-6 md:mx-0">
        <ResponsiveImage
          src={article.featured_image_url}
          alt={altText}
          widths={IMG_WIDTHS.featured}
          sizes={IMG_SIZES.featured}
          width={1200}
          height={675}
          loading="eager"
          fetchpriority="high"
          class="w-full md:rounded-xl"
        />
        {article.featured_image_credit?.photographer_name && (
          <figcaption class="text-xs text-[var(--color-text-muted)] mt-2 px-4 sm:px-6 md:px-0">
            Foto:{' '}
            {article.featured_image_credit.photographer_url ? (
              <a href={article.featured_image_credit.photographer_url} rel="nofollow noopener" target="_blank" class="underline">
                {article.featured_image_credit.photographer_name}
              </a>
            ) : (
              <span>{article.featured_image_credit.photographer_name}</span>
            )}
            {article.featured_image_credit.source_url && (
              <>
                {' / '}
                <a href={article.featured_image_credit.source_url} rel="nofollow noopener" target="_blank" class="underline">
                  {article.featured_image_credit.provider}
                </a>
              </>
            )}
          </figcaption>
        )}
      </figure>
    )}

    {tldr && (
      <aside class="mb-8 rounded-xl border-l-4 bg-[var(--color-bg-soft)] px-5 py-4" style={`border-color: var(--color-accent)`} aria-label="Shrnutí článku">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-1.5">Ve zkratce</p>
        <p class="text-[var(--color-text)] leading-relaxed">{tldr}</p>
      </aside>
    )}

    <div class="article-content prose-base text-[var(--color-text)] leading-relaxed" set:html={safeContent} />

    {faqItems.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[var(--color-border)]" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-display text-2xl font-bold text-[var(--color-text)] mb-5">
          Často kladené otázky
        </h2>
        <div class="flex flex-col gap-2">
          {faqItems.map((f) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-4 py-3">
              <summary class="cursor-pointer list-none font-semibold text-[var(--color-text)] flex items-center justify-between gap-3">
                <span>{f.question.trim()}</span>
                <span class="shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="mt-3 text-[var(--color-text-muted)] leading-relaxed" set:html={sanitizeHtml(f.answer.trim(), { allowedTags: ["b", "strong", "i", "em", "a", "br", "p", "ul", "ol", "li"], allowedAttributes: { a: ["href", "rel", "target"] } })} />
            </details>
          ))}
        </div>
      </section>
    )}

    <AdSlot slot="article-end" variant="display" ratio="4 / 1" />

    {article.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-[var(--color-border)]">
        {article.tags.map((tag) => (
          <span class="px-3 py-1 rounded-full text-xs bg-[var(--color-bg-soft)] text-[var(--color-text-muted)]">{tag}</span>
        ))}
      </div>
    )}

    {(newer || older) && (
      <nav class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10 pt-8 border-t border-[var(--color-border)]" aria-label="Navigace v rubrice">
        {older ? (
          <a href={`/${older.slug}/`} class="block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
            <span class="block text-[10px] uppercase tracking-widest font-bold mb-2 text-[var(--color-text-muted)]">← Starší v rubrice</span>
            <span class="block text-sm font-bold leading-tight">{older.title}</span>
          </a>
        ) : <span></span>}
        {newer ? (
          <a href={`/${newer.slug}/`} class="block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors text-right">
            <span class="block text-[10px] uppercase tracking-widest font-bold mb-2 text-[var(--color-text-muted)]">Novější v rubrice →</span>
            <span class="block text-sm font-bold leading-tight">{newer.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}
  </article>

  {relatedArticles.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <h2 class="font-display text-2xl font-bold mb-6">Mohlo by vás zajímat</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {relatedArticles.map((a) => (
          <ArticleCard article={a} />
        ))}
      </div>
    </section>
  )}

  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <Newsletter />
  </div>
</Base>