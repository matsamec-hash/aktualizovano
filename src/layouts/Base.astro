---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  slug?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  publishedTime?: string | null;
  modifiedTime?: string | null;
  preloadImage?: string | null;
  // LCP preload responzivní varianty (musí matchovat vykreslený <img>, jinak
  // prohlížeč stáhne originál i webp). Když chybí, fallbackne na preloadImage href.
  preloadImageSrcset?: string | null;
  preloadImageSizes?: string | null;
}

const {
  title,
  description,
  image,
  type,
  slug,
  canonical,
  robots,
  jsonLd,
  publishedTime,
  modifiedTime,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      slug={slug}
      canonical={canonical}
      robots={robots}
      jsonLd={jsonLd}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latinext.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latinext.woff2" crossorigin />
    {preloadImageSrcset ? (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        fetchpriority="high"
      />
    ) : (
      preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>