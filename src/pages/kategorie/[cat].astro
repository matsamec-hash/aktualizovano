---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticlesByCategory } from "../../lib/supabase";
import { siteConfig } from "../../../site.config";

export async function getStaticPaths() {
  return siteConfig.categories.map((cat) => ({
    params: { cat: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const articles = await getArticlesByCategory(category.slug);

const breadcrumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Domů", "item": `https://${siteConfig.domain}/` },
    { "@type": "ListItem", "position": 2, "name": category.label, "item": `https://${siteConfig.domain}/kategorie/${category.slug}/` },
  ],
};
---

<Base
  title={`${category.label} — ${siteConfig.name}`}
  description={category.description}
  canonical={`https://${siteConfig.domain}/kategorie/${category.slug}/`}
  jsonLd={breadcrumbsLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-[var(--color-text-muted)] mb-2">Rubrika</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-[var(--color-text)]">{category.label}</h1>
      <p class="mt-3 text-lg text-[var(--color-text-muted)] max-w-2xl">{category.description}</p>
    </header>

    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article, i) => (
          <ArticleCard article={article} priority={i < 3} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-[var(--color-text-muted)]">
        <p class="font-display text-xl mb-2">V této rubrice zatím nejsou články.</p>
        <p class="text-sm">Brzy přidáme obsah.</p>
      </div>
    )}
  </div>
</Base>