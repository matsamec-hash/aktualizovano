---
import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import FloatingCard from "../components/FloatingCard.astro";
import CategoryBlock from "../components/CategoryBlock.astro";
import RecentCarousel from "../components/RecentCarousel.astro";
import { getPublishedArticles } from "../lib/supabase";
import { siteConfig } from "../../site.config";

const articles = await getPublishedArticles();
const heroSlides = articles.slice(0, 4);
const floating = articles.slice(4, 7);
const recent = articles.slice(7, 15);

const articlesByCategory = siteConfig.categories
  .map((cat) => ({
    category: cat,
    articles: articles.filter((a) => a.category === cat.slug).slice(0, 3),
  }))
  .filter((c) => c.articles.length > 0);

// LCP = první slide hero carouselu → preload jeho obrázku (zbytek se lazy-loaduje).
const heroLcpImage = heroSlides[0]?.featured_image_url || undefined;
---

<Base
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
  canonical={`https://${siteConfig.domain}/`}
  preloadImage={heroLcpImage}
>
  {heroSlides.length > 0 && <HeroCarousel articles={heroSlides} />}

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {floating.length > 0 && (
      <div class="relative z-10 -mt-14 mb-16 grid gap-px bg-[var(--color-border)] sm:grid-cols-3 sm:gap-px md:-mt-20">
        {floating.map((article) => <FloatingCard article={article} />)}
      </div>
    )}

    {recent.length > 0 && <RecentCarousel articles={recent} />}

    {articlesByCategory.length > 0 && (
      <section class="mb-16 grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-y-14">
        {articlesByCategory.map(({ category, articles: catArticles }, i) => (
          <CategoryBlock category={category} articles={catArticles} index={i} />
        ))}
      </section>
    )}

    {articles.length === 0 && (
      <div class="py-20 text-center text-[var(--color-text-muted)]">
        <p class="font-display mb-2 text-2xl">Připravujeme obsah</p>
        <p class="text-sm">Brzy zde najdete články ze všech rubrik.</p>
      </div>
    )}
  </div>
</Base>
